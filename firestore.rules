rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accessProfile() {
      return get(/databases/$(database)/documents/accessProfiles/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && accessProfile().role == role;
    }

    function canEdit() {
      return hasRole('admin') || hasRole('editor');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function canAccessShop(shopId) {
      return isAdmin() || (signedIn() && shopId in accessProfile().shopIds);
    }

    function canEditShop(shopId) {
      return canAccessShop(shopId) && canEdit();
    }

    function validCellAmount(cell) {
      return cell.amount is number && cell.amount >= 0 && cell.amount <= 1000000000;
    }

    match /accessProfiles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Password hashes and username mappings stay server-only.
    match /authUsers/{document=**} {
      allow read, write: if false;
    }
    match /authUsernames/{document=**} {
      allow read, write: if false;
    }

    match /shops/{shopId} {
      allow read: if canAccessShop(shopId);
      allow create: if isAdmin();
      allow update: if canEditShop(shopId);
      allow delete: if isAdmin();

      match /performance/{performanceId} {
        allow read: if canAccessShop(shopId);
        allow create, update, delete: if canEditShop(shopId);
      }

      match /bonusSnapshots/{snapshotId} {
        allow read: if canAccessShop(shopId);
        allow create: if canEditShop(shopId);
        allow update, delete: if isAdmin();
      }

      match /dailyClosings/{closingId} {
        allow read: if canAccessShop(shopId);
        allow create: if canEditShop(shopId)
          && (isAdmin() || (validCellAmount(request.resource.data.cell)
            && request.resource.data.cell == { 'amount': request.resource.data.cell.amount, 'note': '' }));
        allow update: if isAdmin() || (canEditShop(shopId)
          && resource.data.status != 'finalized'
          && validCellAmount(request.resource.data.cell)
          && request.resource.data.cell == { 'amount': request.resource.data.cell.amount, 'note': resource.data.cell.note });
        allow delete: if isAdmin();
      }
    }

    match /supervisors/{supervisorId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /weightProfiles/{profileId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /imports/{importId} {
      allow read: if isAdmin();
      allow create, update, delete: if canEdit();

      match /changes/{changeId} {
        allow read: if canAccessShop(changeId);
        allow create, update, delete: if canEdit();
      }
    }

    match /dashboardSummaries/{month} {
      allow read: if isAdmin();
      allow write: if false;

      match /shops/{shopId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /activity/{eventId} {
      allow read: if signedIn();
      allow create: if canEdit()
        && request.resource.data.actor.id == request.auth.uid
        && request.resource.data.actor.role == accessProfile().role
        && request.resource.data.actor.username == accessProfile().username
        && request.resource.data.actor.name == accessProfile().name;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
